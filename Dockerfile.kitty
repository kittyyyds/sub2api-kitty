FROM golang:1.25-alpine AS bridge-build
WORKDIR /bridge-source
COPY canvas-agent/native/comfy-bridge ./
RUN mkdir -p /bridge && GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /bridge/InfiniteCanvas-ComfyBridge.exe . \
    && GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /bridge/InfiniteCanvas-ComfyBridge-linux-amd64 . \
    && GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /bridge/InfiniteCanvas-ComfyBridge-linux-arm64 .

FROM node:22-bookworm-slim AS build
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY VERSION CHANGELOG.md /app/
COPY web ./
COPY --from=bridge-build /bridge/ ./public/
ENV NEXT_PUBLIC_KITTY_MODE=true
ENV NEXT_TELEMETRY_DISABLED=1
RUN node node_modules/next/dist/bin/next build

FROM node:22-bookworm-slim
WORKDIR /app/web
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3101
ENV NEXT_PUBLIC_KITTY_MODE=true
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/web/.next/standalone ./
COPY --from=build /app/web/.next/static ./.next/static
COPY --from=build /app/web/public ./public
USER node
EXPOSE 3101
CMD ["node", "server.js"]
